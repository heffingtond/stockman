<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://sun.com"
        xmlns:xsi="http://w3.org"
        xsi:schemaLocation="http://sun.com 
        http://sun.com/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <display-name>Custom Functions</display-name>
    <tlib-version>1.0</tlib-version>
    <short-name>custom</short-name>
    <uri>http://stockman.com</uri>
    
    <function>
        <!-- The name you will use in your JSP EL expressions -->
        <name>stringToDouble</name>
        <!-- The fully qualified Java class path -->
        <function-class>core.StockManUtilities</function-class>
        <!-- The exact method signature matching the Java class -->
        <function-signature>double stringToDouble( java.lang.String )</function-signature>
    </function>
    <function>
        <!-- The name you will use in your JSP EL expressions -->
        <name>formatToDollar</name>
        <!-- The fully qualified Java class path -->
        <function-class>core.StockManUtilities</function-class>
        <!-- The exact method signature matching the Java class -->
        <function-signature>java.lang.String formatToDollar( java.lang.String )</function-signature>
    </function>
</taglib>
